# Copy this file to .env and fill in real values before running the app.

# PostgreSQL connection string. Locally (with docker-compose) this matches
# the credentials in docker-compose.yml. In production, use the connection
# string your database host (e.g. Railway, Render, Supabase, RDS) gives you.
DATABASE_URL="postgresql://meridian:meridian@localhost:5432/meridian?schema=public"

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

PORT=4000

# Restrict this to your real frontend domain in production, e.g.
# CORS_ORIGIN="https://training.example.com"
CORS_ORIGIN="*"

# ---- Real Nafath integration (see README.md "Nafath integration") ----
# Obtained after signing an integration agreement with the National
# Information Center. Leave blank until you have real credentials.
# NAFATH_CLIENT_ID=
# NAFATH_CLIENT_SECRET=
# NAFATH_REDIRECT_URI=

# ---- Real payment gateway (see README.md "Payments integration") ----
# Pick a Saudi-market aggregator that supports mada, Apple Pay and STC Pay
# (Moyasar, PayTabs and HyperPay all do), or use their examples directly.
# PAYMENT_GATEWAY_API_KEY=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=

# ---- Live video sessions (Daily.co) — see README.md "Live video sessions" ----
# Sign up free at https://dashboard.daily.co, create an API key under
# Developers, and paste it here. Without it, scheduling a live session
# fails with a clear error rather than doing nothing silently.
# DAILY_API_KEY=
# DAILY_API_URL=https://api.daily.co/v1
