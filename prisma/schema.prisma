datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  TRAINEE
  TRAINER
  CONSULTANT
  ADMIN
  MARKETER
  INSTITUTION
}

model User {
  id            String       @id @default(uuid())
  nationalId    String?      @unique // legacy identifier, optional now that email is primary
  email         String?      @unique // primary login identifier going forward
  name          String
  nameEn        String?      // English form of the name, collected separately at registration
  phone         String?
  whatsapp      String?
  nationality   String?
  address       String?
  socialLinks   String?      // free-text list of social profile links
  academicSpecialization   String?
  academicSpecializationAr String?
  wantsMarketingIncome     Boolean? // "interested in earning via referrals" checkbox at signup — a lead flag, not a role grant
  passwordHash  String
  role          Role         @default(TRAINEE)
  createdAt     DateTime     @default(now())

  // Trainer/consultant public profile fields — shown on the trainer's
  // public profile page. Optional and irrelevant for TRAINEE/ADMIN roles.
  // title/titleAr double as "training specialization" collected at
  // registration for TRAINER/CONSULTANT applicants.
  bio           String?
  bioAr         String?
  title         String?      // professional title/headline, e.g. "Senior GRC Consultant"
  titleAr       String?
  photoUrl      String?
  credentials   String?      // free-text list of certifications/credentials
  credentialsAr String?

  // Marketer/affiliate fields — only meaningful for role MARKETER
  referralCode    String?  @unique
  commissionRate  Float?   @default(10) // percent of sale amount

  enrollments        Enrollment[]        @relation("TraineeEnrollments")
  sponsoredEnrollments Enrollment[]      @relation("InstitutionSponsoredEnrollments")
  coursesTaught      Course[]            @relation("InstructorCourses")
  certificates       Certificate[]
  courseReviews      CourseReview[]
  payments           Payment[]
  subscriptions      Subscription[]
  consultingServices ConsultingService[] @relation("ConsultantServices")
  blogPosts          BlogPost[]          @relation("AuthorPosts")
  workItems          TrainerWork[]       @relation("TrainerWorkItems")
  referralsMade      Referral[]          @relation("MarketerReferrals")
  referralsReceived  Referral[]          @relation("BuyerReferrals")
}

// A portfolio item shown on a trainer/consultant's public profile page —
// a past project, publication, workshop delivered, etc.
model TrainerWork {
  id          String   @id @default(uuid())
  trainer     User     @relation("TrainerWorkItems", fields: [trainerId], references: [id], onDelete: Cascade)
  trainerId   String
  title       String
  titleAr     String?
  description String?
  descriptionAr String?
  linkUrl     String?  // optional external link (article, case study, etc.)
  fileUrl     String?  // optional uploaded file (PDF sample, portfolio piece)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

// A downloadable file attached to a course — student reference material
// or a full "training kit" bundle (slides, workbook, templates). kind
// distinguishes the two so the frontend can group them under separate
// headings.
model CourseMaterial {
  id       String   @id @default(uuid())
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String
  title    String
  titleAr  String?
  kind     String   @default("reference") // "reference" | "kit"
  fileUrl  String
  fileName String?
  order    Int      @default(0)
  createdAt DateTime @default(now())
}

// category is required and is the canonical value used for filtering
// (existing data — including the SCL catalog seed — stores this in
// Arabic). categoryEn is an optional English label for the same axis,
// shown instead of category when the frontend is in English; when it's
// missing, the frontend falls back to showing category as-is.
model Course {
  id               String        @id @default(uuid())
  title            String
  titleAr          String?
  category         String
  categoryEn       String?
  description      String
  descriptionAr    String?
  previewVideoUrl  String?       // free marketing/preview video — public, no enrollment required
  price            Decimal       @db.Decimal(10, 2)
  instructor       User          @relation("InstructorCourses", fields: [instructorId], references: [id])
  instructorId     String
  modules          Module[]
  materials        CourseMaterial[]
  enrollments      Enrollment[]
  payments         Payment[]
  liveSessions     LiveSession[]
  reviews          CourseReview[]
  createdAt        DateTime      @default(now())
}

model Module {
  id       String   @id @default(uuid())
  title    String
  titleAr  String?
  order    Int
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String
  lessons  Lesson[]
}

model Lesson {
  id              String            @id @default(uuid())
  title           String
  titleAr         String?
  durationSeconds Int
  order           Int
  videoUrl        String?
  module          Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId        String
  progress        LessonProgress[]
}

model Enrollment {
  id          String            @id @default(uuid())
  user        User              @relation("TraineeEnrollments", fields: [userId], references: [id])
  userId      String
  course      Course            @relation(fields: [courseId], references: [id])
  courseId    String
  paymentId   String?
  sponsor     User?             @relation("InstitutionSponsoredEnrollments", fields: [sponsorId], references: [id])
  sponsorId   String?
  enrolledAt  DateTime          @default(now())
  progress    LessonProgress[]
  certificate Certificate?

  @@unique([userId, courseId])
}

model LessonProgress {
  id             String     @id @default(uuid())
  enrollment     Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  enrollmentId   String
  lesson         Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId       String
  watchedSeconds Int        @default(0)
  completed      Boolean    @default(false)
  updatedAt      DateTime   @updatedAt

  @@unique([enrollmentId, lessonId])
}

model Certificate {
  id           String     @id @default(uuid())
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  enrollmentId String     @unique
  refCode      String     @unique
  issuedAt     DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id])
  userId       String
}

// One password reset token. A request creates a row here and emails the
// token to the user; the reset endpoint consumes it (marks used) so it
// can never be replayed, and it expires after a short window regardless.
model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// A trainee's rating and optional written review for a course they're
// enrolled in. One review per trainee per course (enforced by the
// unique constraint) — resubmitting updates the existing one.
model CourseReview {
  id        String   @id @default(uuid())
  course    Course   @relation(fields: [courseId], references: [id])
  courseId  String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  rating    Int      // 1-5
  comment   String?
  createdAt DateTime @default(now())

  @@unique([courseId, userId])
}

model Payment {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  course    Course   @relation(fields: [courseId], references: [id])
  courseId  String
  amount    Decimal  @db.Decimal(10, 2)
  method    String
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

// One recorded sale attributed to a marketer's referral code — created
// automatically when a buyer who arrived via ?ref=CODE completes a paid
// enrollment or subscription purchase. commissionAmount is calculated
// at the marketer's commissionRate at the time of the sale (a rate
// change later does not retroactively change past referrals).
model Referral {
  id               String   @id @default(uuid())
  marketer         User     @relation("MarketerReferrals", fields: [marketerId], references: [id])
  marketerId       String
  buyer            User     @relation("BuyerReferrals", fields: [buyerId], references: [id])
  buyerId          String
  saleType         String   // "enrollment" | "subscription"
  saleAmount       Decimal  @db.Decimal(10, 2)
  commissionRate   Float
  commissionAmount Decimal  @db.Decimal(10, 2)
  status           String   @default("pending") // pending | paid
  paymentId        String?  @unique
  createdAt        DateTime @default(now())
}

// Single-row table holding site-wide branding/settings the admin can edit
// (name, description, logo, accent color). id is always the literal
// string "platform" so there is only ever one row.
model PlatformSettings {
  id            String  @id @default("platform")
  maintenanceMode Boolean @default(false)
  siteName      String  @default("Mada Alhyat Training Center")
  siteNameAr    String  @default("مركز مدى الحياة للتدريب")
  description   String  @default("Structured professional training in business, safety and digital skills.")
  descriptionAr String  @default("تدريب مهني منظم في الأعمال والسلامة والمهارات الرقمية.")
  logoUrl       String?
  sclLogoUrl    String? // separate logo for the Smart Compliance Leap (SCL) brand, shown on consulting/solutions listings
  primaryColor  String  @default("#8A6A34")
  phone         String? @default("+966 561 919 110")
  email         String? @default("info@lltc.sa")
  addressRiyadh   String? @default("Riyadh Office — King Fahd Road, Olaya, in front of Kingdom Tower, above Eklil Lebanon Restaurant, Riyadh, Saudi Arabia")
  addressRiyadhAr String? @default("مكتب الرياض - طريق الملك فهد، العليا، مقابل برج المملكة، فوق مطعم إكليل لبنان، الرياض، المملكة العربية السعودية")
  addressCairo    String? @default("Cairo Office — Makram Ebeid St., Nasr City, Cairo, Egypt")
  addressCairoAr  String? @default("مكتب القاهرة - شارع مكرم عبيد، مدينة نصر، القاهرة، مصر")
  taxNumber       String? // VAT registration number (Mada Alhyat)
  crNumber        String? // Commercial Registration number (Mada Alhyat)
  socialLinkedin  String?
  socialTwitter   String?
  socialInstagram String?
  socialFacebook  String?
  sclCompanyName   String? @default("Smart Compliance Leap")
  sclCompanyNameAr String? @default("قفزة الامتثال الذكي")
  sclTaxNumber     String? // VAT registration number (SCL, separate legal entity)
  sclCrNumber      String? // Commercial Registration number (SCL)
  visionEn        String?
  visionAr        String?
  missionEn       String?
  missionAr       String?
}

// A bank account shown in the site footer for wire transfers. Multiple
// accounts are supported (e.g. one for Mada Alhyat, one for SCL) —
// label distinguishes them for the visitor; order controls display order.
model BankAccount {
  id            String   @id @default(uuid())
  label         String   // e.g. "Mada Alhyat Training Center" or "Smart Compliance Leap"
  labelAr       String?
  bankName      String
  accountName   String
  iban          String
  swift         String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
}

// A scheduled live video class for a course, backed by a video-conferencing
// provider room (Daily.co by default — see src/lib/dailyco.js). joinUrl is
// only ever returned to the course's own trainer/admin and to trainees
// enrolled in the course, never on the public course listing.
model LiveSession {
  id              String   @id @default(uuid())
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId        String
  title           String
  scheduledAt     DateTime
  durationMinutes Int      @default(60)
  provider        String   @default("daily")
  roomName        String
  joinUrl         String
  createdAt       DateTime @default(now())
}

// ---------------------------------------------------------------------
// Subscription plans (catalog-wide access for a period, instead of
// paying per course) — e.g. Basic / Silver / Gold / Platinum.
// ---------------------------------------------------------------------
model SubscriptionPlan {
  id             String         @id @default(uuid())
  tier           String         @unique // e.g. "basic", "silver", "gold", "platinum" — used as a stable key
  name           String
  nameAr         String?
  description    String
  descriptionAr  String?
  durationDays   Int
  price          Decimal        @db.Decimal(10, 2)
  liveSessionsPerMonth Int?     // null = unlimited
  prioritySupport      Boolean  @default(false)
  active               Boolean  @default(true)
  subscriptions  Subscription[]
  createdAt      DateTime       @default(now())
}

model Subscription {
  id        String           @id @default(uuid())
  user      User             @relation(fields: [userId], references: [id])
  userId    String
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])
  planId    String
  status    String           @default("pending") // pending | active | expired | cancelled
  startDate DateTime?
  endDate   DateTime?
  paymentId String?
  createdAt DateTime         @default(now())
}

// ---------------------------------------------------------------------
// Public applications to become a trainer or consultant. Submitted with
// no login required; an admin reviews and approves/rejects. Approval is
// what actually creates (or upgrades) the User account — this is the
// only path to a TRAINER or CONSULTANT account, closing the privilege-
// escalation hole that used to exist in /api/auth/register (see that
// route's comments).
// ---------------------------------------------------------------------
model ProviderApplication {
  id           String    @id @default(uuid())
  name         String
  nameEn       String?
  nationalId   String?
  phone        String
  whatsapp     String?
  email        String
  nationality  String?
  address      String?
  socialLinks  String?
  appliedRole  Role      // TRAINER or CONSULTANT
  bio          String
  bioAr        String?
  specialization   String   // training specialization
  specializationAr String?
  academicSpecialization   String?
  academicSpecializationAr String?
  wantsMarketingIncome Boolean?
  photoUrl     String?
  cvUrl        String?
  portfolioUrl String?
  status       String    @default("pending") // pending | approved | rejected
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime  @default(now())
}

// ---------------------------------------------------------------------
// Consulting services — a separate line of business from courses.
// Companies/trainees submit a ConsultingRequest against one of these;
// no login required to submit a request (matches how consulting leads
// work in practice — the inquirer is often a company, not a registered
// trainee).
// ---------------------------------------------------------------------
model ConsultingService {
  id             String              @id @default(uuid())
  title          String
  titleAr        String?
  category       String
  categoryEn     String?
  description    String
  descriptionAr  String?
  consultant     User                @relation("ConsultantServices", fields: [consultantId], references: [id])
  consultantId   String
  active         Boolean             @default(true)
  requests       ConsultingRequest[]
  createdAt      DateTime            @default(now())
}

model ConsultingRequest {
  id           String            @id @default(uuid())
  service      ConsultingService @relation(fields: [serviceId], references: [id])
  serviceId    String
  name         String
  email        String
  phone        String?
  company      String?
  message      String
  status       String            @default("new") // new | contacted | closed
  createdAt    DateTime          @default(now())
}

// ---------------------------------------------------------------------
// Corporate (B2B) packages — bulk/organizational training deals, sold by
// inquiry rather than instant self-serve checkout (matches how B2B
// training packages are actually sold: a company reaches out, gets a
// quote, and is invoiced directly — there's no card-checkout flow here
// on purpose).
// ---------------------------------------------------------------------
model CorporatePackage {
  id            String                     @id @default(uuid())
  tier          String                     @unique
  name          String
  nameAr        String?
  description   String
  descriptionAr String?
  seatsIncluded Int?                       // null = custom/negotiated
  priceFrom     Decimal?                   @db.Decimal(10, 2) // null = "contact us for a quote"
  active        Boolean                    @default(true)
  inquiries     CorporatePackageInquiry[]
  createdAt     DateTime                   @default(now())
}

model CorporatePackageInquiry {
  id          String           @id @default(uuid())
  package     CorporatePackage @relation(fields: [packageId], references: [id])
  packageId   String
  companyName String
  contactName String
  email       String
  phone       String?
  seats       Int?
  message     String
  status      String           @default("new") // new | contacted | closed
  createdAt   DateTime         @default(now())
}

// ---------------------------------------------------------------------
// Blog — no posts are seeded with fabricated content; this is just the
// schema/API/admin UI for the team to publish their own real posts.
// ---------------------------------------------------------------------
model BlogPost {
  id            String    @id @default(uuid())
  slug          String    @unique
  title         String
  titleAr       String?
  excerpt       String
  excerptAr     String?
  body          String
  bodyAr        String?
  category      String
  coverImageUrl String?
  published     Boolean   @default(false)
  publishedAt   DateTime?
  author        User      @relation("AuthorPosts", fields: [authorId], references: [id])
  authorId      String
  createdAt     DateTime  @default(now())
}

// ---------------------------------------------------------------------
// Business (technology) solutions — the company's third real business
// line from the profile PDF ("الحلول التقنية / نظم المعلومات"),
// distinct from courses and consulting. Company-wide (not tied to a
// specific consultant), managed by admins. Public inquiry, same
// no-login pattern as consulting requests.
// ---------------------------------------------------------------------
model BusinessSolution {
  id            String                    @id @default(uuid())
  title         String
  titleAr       String?
  category      String
  categoryEn    String?
  description   String
  descriptionAr String?
  partnerBrand  String?
  active        Boolean                   @default(true)
  requests      BusinessSolutionRequest[]
  createdAt     DateTime                  @default(now())
}

model BusinessSolutionRequest {
  id        String           @id @default(uuid())
  solution  BusinessSolution @relation(fields: [solutionId], references: [id])
  solutionId String
  name      String
  email     String
  phone     String?
  company   String?
  message   String
  status    String           @default("new") // new | contacted | closed
  createdAt DateTime         @default(now())
}

// ---------------------------------------------------------------------
// General "Contact Us" messages — separate from consulting/corporate
// inquiries, for anyone who just wants to reach the company directly.
// ---------------------------------------------------------------------
model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    String   @default("new") // new | read | closed
  createdAt DateTime @default(now())
}
